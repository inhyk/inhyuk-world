{
  "name": "inhyuk-world",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "games/snowflow",
    "games/valorant"
  ],
  "scripts": {
    "predev": "npm run free-drive:build && npm run snowflow:build && npm run valorant:build && npm run deep-dig:build && npm run blocktopia:build",
    "dev": "next dev",
    "build": "npm run free-drive:build && npm run snowflow:build && npm run valorant:build && npm run deep-dig:build && npm run blocktopia:build && next build",
    "start": "next start",
    "lint": "eslint",
    "snowflow:dev": "npm run dev --workspace=@inhyuk/snowflow",
    "snowflow:build": "npm run build --workspace=@inhyuk/snowflow",
    "valorant:dev": "npm run dev --workspace=@inhyuk/valorant-protocol",
    "valorant:build": "npm run build --workspace=@inhyuk/valorant-protocol",
    "test:valorant": "npm run test --workspace=@inhyuk/valorant-protocol",
    "test": "node --test \"games/snowflow/tests/*.test.js\" \"games/mettaton/*.test.mjs\" \"games/orbit-breaker/*.test.mjs\" \"games/undertale/*.test.mjs\" \"games/valorant/tests/*.test.mjs\" \"games/deep-dig/*.test.mjs\" \"games/free-drive/*.test.mjs\"",
    "test:orbit-breaker": "node --test \"games/orbit-breaker/*.test.mjs\"",
    "test:mettaton": "node --test \"games/mettaton/*.test.mjs\"",
    "test:undertale": "node --test \"games/undertale/*.test.mjs\"",
    "deep-dig:build": "vite build --config games/deep-dig/vite.config.js",
    "deep-dig:dev": "vite --config games/deep-dig/vite.config.js --host 127.0.0.1",
    "test:deep-dig": "node --test games/deep-dig/core.test.mjs",
    "blocktopia:build": "vite build --config games/blocktopia/vite.config.js",
    "blocktopia:dev": "vite --config games/blocktopia/vite.config.js --host 127.0.0.1",
    "test:blocktopia": "node --test games/blocktopia/core.test.mjs",
    "free-drive:build": "vite build --config games/free-drive/vite.config.js",
    "free-drive:dev": "vite --config games/free-drive/vite.config.js --host 127.0.0.1",
    "test:free-drive": "node --test \"games/free-drive/*.test.mjs\""
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "motion": "^12.33.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "@babylonjs/loaders": "9.18.0",
    "peerjs": "1.5.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
